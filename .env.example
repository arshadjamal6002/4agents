# Copy to .env and fill in values:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS/Linux)

# ── OpenAI (replaces Ollama from the freeCodeCamp book) ───────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ── Storage ────────────────────────────────────────────────────────────────
CHECKPOINT_DB=data/checkpoints.db
NOTES_PATH=study_materials/sample_notes

# ── Demo length (optional) ─────────────────────────────────────────────────
# Trim planner roadmaps for short demos / tracing tests (Streamlit defaults to 2).
DEMO_MAX_TOPICS=2

# ── Langfuse (Version 6 — cloud or self-hosted) ────────────────────────────
# Leave empty to run without tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Cloud (recommended without Docker):
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional alias used by some docs / self-hosted:
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── A2A (Version 8 — unused until then) ────────────────────────────────────
QUIZ_SERVICE_URL=http://localhost:9001
STUDY_BUDDY_URL=http://localhost:9002
USE_A2A_QUIZ=false
USE_STUDY_BUDDY=false
