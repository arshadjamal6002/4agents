# Copy to .env and fill in values:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS/Linux)

# ── OpenAI (replaces Ollama from the freeCodeCamp book) ───────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ── Storage ────────────────────────────────────────────────────────────────
CHECKPOINT_DB=data/checkpoints.db
NOTES_PATH=study_materials/sample_notes

# ── Langfuse (Chapter 6 — leave empty for now) ─────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ── A2A (Chapter 8 — unused until then) ────────────────────────────────────
QUIZ_SERVICE_URL=http://localhost:9001
STUDY_BUDDY_URL=http://localhost:9002
USE_A2A_QUIZ=false
USE_STUDY_BUDDY=false
